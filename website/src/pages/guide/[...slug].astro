---
import { getCollection, render } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";
import DocumentationNav from "../../components/data/DocumentationNav.astro";
import EvidenceLinks from "../../components/data/EvidenceLinks.astro";
import CommandBlock from "../../components/data/CommandBlock.astro";
import { catalog, stable } from "../../data/catalog";
import { withBase } from "../../lib/urls";
import configExample from "../../content/examples/config.toml?raw";
import actionExample from "../../content/examples/actions.toml?raw";
export async function getStaticPaths() {
  return (await getCollection("guides")).map((entry) => {
    if (
      entry.data.productVersion !== stable.version ||
      entry.data.evidenceIds.some(
        (id) => !catalog.evidence.some((e) => e.id === id),
      )
    )
      throw new Error(`Invalid guide references: ${entry.id}`);
    return {
      params: {
        slug: entry.data.slug === "start" ? undefined : entry.data.slug,
      },
      props: { entry },
    };
  });
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ContentLayout
  title={entry.data.title}
  description={entry.data.description}
  eyebrow={`Guide / v${entry.data.productVersion}`}
>
  <div class="guide-layout">
    <DocumentationNav />
    <article class="prose">
      <p class="guide-meta">Reviewed {entry.data.updatedOn} · English</p>
      <Content />
      {entry.data.slug === "configuration" && (
        <>
          <h2 id="examples">Parser-checked examples</h2>
          <p>
            Merge these sections into your existing configuration rather than
            replacing unrelated settings. Do not duplicate a TOML table or an
            action ID.
          </p>
          <CommandBlock
            title="config.toml settings"
            code={configExample.trim()}
          />
          <CommandBlock
            title="actions.toml custom action"
            code={actionExample.trim()}
          />
          <p>
            Both examples were accepted by the actual configuration/action
            parsers. The custom action was parsed, not executed.
          </p>
        </>
      )}
      <EvidenceLinks ids={entry.data.evidenceIds} />
      <nav class="page-links" aria-label="Guide resources">
        <a href={withBase("download/")}>Installation →</a>
        <a href={withBase("contribute/")}>Report an issue →</a>
      </nav>
    </article>
  </div>
</ContentLayout>
<style>
  .guide-layout {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 4rem;
    align-items: start;
  }
  .guide-meta {
    font:
      0.7rem ui-monospace,
      monospace;
    color: var(--text-muted);
  }
  @media (max-width: 52rem) {
    .guide-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
