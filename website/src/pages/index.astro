---
import SiteLayout from "../layouts/SiteLayout.astro";
import Hero from "../components/product/Hero.astro";
import WorkflowStory from "../components/product/WorkflowStory.astro";
import WheelDemo from "../components/demo/WheelDemo.astro";
import Features from "../components/product/Features.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Button from "../components/ui/Button.astro";
import { site } from "../data/site";
import { withBase } from "../lib/urls";
---

<SiteLayout>
  <Hero />
  <WorkflowStory />
  <Features />
  <WheelDemo />
  <section
    id="compatibility"
    class="compatibility-section"
    aria-labelledby="compatibility-title"
  >
    <div class="container compatibility-grid">
      <SectionHeading
        eyebrow="Know your desktop"
        title="Built for Linux. Rooted in X11."
        id="compatibility-title"
      >
        <p class="muted">
          A good fit starts with the right setup. Check your session before
          downloading.
        </p>
      </SectionHeading>
      <div>
        <dl class="support-list">
          <div>
            <dt>
              <span class="support-mark" aria-hidden="true">
                ✓
              </span>
              Primary tested setup
            </dt>
            <dd>
              Linux Mint 22.3, Cinnamon X11, Nemo, amd64. This is the reference
              desktop for Radivine.
            </dd>
          </div>
          <div>
            <dt>
              <span class="support-mark" aria-hidden="true">
                ↗
              </span>
              Other X11 desktops
            </dt>
            <dd>
              Desktop and file-manager integration require verification on your
              specific environment.
            </dd>
          </div>
          <div>
            <dt>
              <span class="support-mark" aria-hidden="true">
                —
              </span>
              Native Wayland unsupported
            </dt>
            <dd>
              The wheel requires X11. XWayland Invoke is experimental and
              conditional; Drag + Shift is unavailable on Wayland.
            </dd>
          </div>
        </dl>
        <p style="margin-top:1.5rem">
          <a class="text-link" href={withBase("compatibility/")}>
            Read the full compatibility matrix →
          </a>
        </p>
      </div>
    </div>
  </section>
  <section
    class="container closing"
    aria-labelledby="closing-title"
    data-reveal
  >
    <svg
      class="closing-branches"
      viewBox="0 0 800 400"
      fill="none"
      aria-hidden="true"
    >
      <path
        class="draw-path"
        pathLength="1"
        d="M400 450V260Q400 180 470 120L610 0 M400 330Q400 240 320 190L80 30 M400 260Q400 200 620 210L830 200"
      />
      <circle cx="470" cy="120" r="8" />
      <circle cx="320" cy="190" r="8" />
      <circle cx="620" cy="210" r="8" />
    </svg>
    <div>
      <p class="eyebrow">Open source. Open possibilities.</p>
      <h2 id="closing-title">
        Make it part of
        <br />
        your workflow.
      </h2>
      <p class="muted">
        Get v{site.version} for Linux X11, or help shape what grows next.
      </p>
    </div>
    <div class="actions">
      <Button href={site.release}>View v{site.version} release</Button>
      <Button href={withBase("contribute/")} variant="secondary">
        Ways to contribute
      </Button>
    </div>
  </section>
</SiteLayout>
<style>
  .compatibility-section {
    background: var(--surface);
    padding-block: var(--space-section);
    border-block: 1px solid var(--border);
  }
  .compatibility-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
  }
  .compatibility-grid :global(.section-heading) {
    margin-bottom: 0;
  }
  .support-list {
    margin: 0;
  }
  .support-list div {
    padding-block: 1.2rem;
    border-bottom: 1px solid var(--border);
  }
  .support-list div:first-child {
    padding-top: 0;
  }
  .support-list div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  dt {
    font-weight: 550;
    font-size: 0.9rem;
  }
  dd {
    margin: 0.5rem 0 0 1.8rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .support-mark {
    color: var(--accent);
    display: inline-block;
    width: 1.8rem;
  }
  .closing {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 5rem);
    background: var(--surface-muted);
    border: 1px solid var(--border);
    border-radius: 0;
    margin-bottom: var(--space-section);
    margin-top: 2rem;
  }
  .closing h2 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin-bottom: 1rem;
  }
  .closing p:last-child {
    font-size: 0.85rem;
    margin-bottom: 0;
  }
  .closing .actions {
    align-items: stretch;
    flex-direction: column;
  }
  .closing-branches {
    position: absolute;
    right: -7%;
    bottom: -15%;
    height: 130%;
    width: 70%;
    z-index: -1;
    stroke: var(--border);
    stroke-width: 1.5;
  }
  .closing-branches circle {
    fill: var(--surface);
  }
  @media (max-width: 52rem) {
    .compatibility-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .closing {
      padding: 2rem;
    }
    .closing-branches {
      width: 100%;
      right: -35%;
      opacity: 0.6;
    }
  }
  @media (max-width: 40rem) {
    .closing {
      padding: 1.5rem;
    }
    .closing .actions {
      width: 100%;
    }
  }
</style>
