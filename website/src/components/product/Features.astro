---
import { withBase } from "../../lib/urls";
---

<section class="features section" aria-labelledby="features-title">
  <div class="container">
    <div class="feature-heading">
      <p class="eyebrow">02 / Beyond the gesture</p>
      <h2 id="features-title">
        Small movements.
        <br />
        <em>Useful possibilities.</em>
      </h2>
      <p class="muted">
        A different way to get to the tools you need.
        <br />
        Built around files, made for your flow.
      </p>
    </div>
    <article class="feature-row" data-reveal>
      <div class="feature-visual preview-visual" aria-hidden="true">
        <svg viewBox="0 0 540 360" fill="none">
          <g class="feature-guides">
            <circle cx="270" cy="180" r="147" />
            <path d="M30 180h480M270 20v320" />
          </g>
          <g class="visual-layer" style="--i:0">
            <rect
              class="paper paper-back"
              x="120"
              y="73"
              width="188"
              height="230"
              rx="6"
              transform="rotate(-13 120 73)"
            />
          </g>
          <g class="visual-layer" style="--i:1">
            <rect
              class="paper"
              x="168"
              y="53"
              width="204"
              height="253"
              rx="6"
            />
            <path
              class="text-lines"
              d="M195 94h54m-54 25h150m-150 17h118m-118 17h139m-139 17h84m-84 50h150m-150 17h118m-118 17h139m-139 17h84"
            />
            <path class="highlight draw-path" pathLength="1" d="M195 189h150" />
          </g>
          <g class="visual-layer" style="--i:2">
            <circle class="focus-lens" cx="370" cy="239" r="49" />
            <path class="lens-mark" d="M355 239h30m-15-15v30" />
          </g>
        </svg>
        <span class="visual-caption">TEXT / AN ILLUSTRATED STUDY</span>
      </div>
      <div class="feature-copy">
        <span class="feature-index">01 — LOOK CLOSER</span>
        <h3>
          A little context.
          <br />A clearer next step.
        </h3>
        <p>
          Read-only text preview puts a file’s contents within reach. Explore
          the full text, its beginning, or its end.
        </p>
        <div class="feature-notations">
          <span>Full</span>
          <span>Head</span>
          <span>Tail</span>
        </div>
        <a class="text-link" href={withBase("guide/#capabilities")}>
          Meet the text viewer <span aria-hidden="true">↗</span>
        </a>
      </div>
    </article>
    <article class="feature-row feature-reverse" data-reveal>
      <div class="feature-visual conversion-visual" aria-hidden="true">
        <svg viewBox="0 0 540 360" fill="none">
          <g class="feature-guides">
            <circle cx="270" cy="180" r="140" />
            <circle cx="270" cy="180" r="90" />
            <path d="M35 180h470" />
          </g>
          <path
            class="conversion-path draw-path"
            pathLength="1"
            d="M120 180H220Q270 180 300 125T420 70 M220 180Q270 180 300 235T420 290 M220 180H420"
          />
          <g class="visual-layer" style="--i:0">
            <rect
              class="image-tile"
              x="65"
              y="122"
              width="116"
              height="116"
              rx="9"
              transform="rotate(-8 123 180)"
            />
            <path class="image-landscape" d="M82 214l32-40 23 24 16-15 17 22" />
            <circle class="image-sun" cx="144" cy="151" r="11" />
          </g>
          <g class="format-chip visual-layer" style="--i:1">
            <rect x="365" y="44" width="101" height="52" rx="26" />
            <text x="415" y="76">
              PNG
            </text>
          </g>
          <g class="format-chip visual-layer" style="--i:2">
            <rect x="365" y="154" width="101" height="52" rx="26" />
            <text x="415" y="186">
              JPEG
            </text>
          </g>
          <g class="format-chip visual-layer" style="--i:3">
            <rect x="365" y="264" width="101" height="52" rx="26" />
            <text x="415" y="296">
              WebP
            </text>
          </g>
        </svg>
        <span class="visual-caption">IMAGE FORMATS / AN ILLUSTRATED STUDY</span>
      </div>
      <div class="feature-copy">
        <span class="feature-index">02 — CHANGE THE FORMAT</span>
        <h3>
          Same image.
          <br />
          New possibilities.
        </h3>
        <p>
          Convert static PNG, JPEG, and WebP images. Go further with native
          Advanced Convert and keep track of work in Jobs.
        </p>
        <div class="feature-notations">
          <span>PNG</span>
          <span>JPEG</span>
          <span>WebP</span>
        </div>
        <a class="text-link" href={withBase("guide/#capabilities")}>
          Explore image conversion <span aria-hidden="true">↗</span>
        </a>
      </div>
    </article>
    <article class="control-feature" data-reveal>
      <div class="control-art" aria-hidden="true">
        <svg viewBox="0 0 400 260" fill="none">
          <g class="control-tracks">
            <path d="M40 70h320M40 130h320M40 190h320" />
          </g>
          <g class="control-values">
            <path
              class="draw-path"
              pathLength="1"
              d="M40 70h105M40 130h230M40 190h155"
            />
          </g>
          <g class="visual-layer" style="--i:0">
            <circle cx="145" cy="70" r="17" />
          </g>
          <g class="visual-layer" style="--i:1">
            <circle cx="270" cy="130" r="17" />
          </g>
          <g class="visual-layer" style="--i:2">
            <circle cx="195" cy="190" r="17" />
          </g>
        </svg>
        <span class="visual-caption">CONFIGURATION / AN ILLUSTRATED STUDY</span>
      </div>
      <div>
        <span class="feature-index">03 — MAKE IT YOURS</span>
        <h3>
          Your wheel.
          <br />
          Your way of working.
        </h3>
        <p>
          Choose your layout in the native Control Center. Connect your own
          commands with configured argv actions and installed programs.
        </p>
        <p class="command-note">
          Default terminal, checksum, and executable examples only log; they do
          not perform those commands.
        </p>
        <a class="text-link" href={withBase("guide/#capabilities")}>
          Explore the available tools <span aria-hidden="true">↗</span>
        </a>
      </div>
    </article>
  </div>
</section>
<style>
  .features {
    background: var(--surface);
    border-block: 1px solid var(--border);
  }
  .feature-heading {
    text-align: center;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .feature-heading .eyebrow {
    justify-content: center;
  }
  .feature-heading h2 {
    font-size: clamp(2.5rem, 5vw, 4.7rem);
    margin-bottom: 1.5rem;
  }
  .feature-heading em {
    font-style: normal;
    color: var(--accent);
  }
  .feature-heading p {
    margin-inline: auto;
  }
  .feature-row {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 7vw, 7rem);
    align-items: center;
    margin-block: 4rem 7rem;
  }
  .feature-reverse {
    grid-template-columns: 1fr 1.15fr;
  }
  .feature-reverse .feature-visual {
    grid-column: 2;
    grid-row: 1;
  }
  .feature-reverse .feature-copy {
    grid-column: 1;
    grid-row: 1;
  }
  .feature-visual {
    background: var(--canvas);
    border: 1px solid var(--border);
    border-radius: 50% 50% 0.75rem 0.75rem;
    padding: 2rem 0 1.25rem;
    overflow: hidden;
  }
  .conversion-visual {
    border-radius: 0.75rem 5rem 0.75rem 5rem;
    background: var(--surface-muted);
  }
  svg {
    width: 100%;
    display: block;
  }
  .feature-guides {
    stroke: var(--border);
  }
  .paper {
    fill: var(--surface);
    stroke: var(--border);
  }
  .paper-back {
    fill: var(--surface-muted);
  }
  .text-lines {
    stroke: var(--text-muted);
    stroke-width: 3;
    opacity: 0.55;
  }
  .highlight {
    stroke: var(--accent);
    stroke-width: 6;
  }
  .focus-lens {
    fill: var(--action);
  }
  .lens-mark {
    stroke: var(--on-action);
    stroke-width: 2;
  }
  .visual-caption {
    display: block;
    text-align: center;
    font:
      0.55rem ui-monospace,
      monospace;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    padding-inline: 1rem;
  }
  .feature-index {
    color: var(--accent);
    font:
      0.65rem ui-monospace,
      monospace;
    letter-spacing: 0.1em;
  }
  h3 {
    font-size: clamp(2rem, 3.3vw, 3.2rem);
    font-weight: 540;
    line-height: 1.1;
    letter-spacing: -0.06em;
    margin-block: 1.2rem;
  }
  .feature-copy p,
  .control-feature p {
    color: var(--text-muted);
    font-size: 0.9rem;
    max-width: 44ch;
  }
  .feature-notations {
    display: flex;
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .feature-notations span {
    padding-block: 0.25rem;
    border-block: 1px solid var(--border);
    font:
      0.65rem ui-monospace,
      monospace;
  }
  .text-link {
    font-size: 0.8rem;
  }
  .conversion-path {
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .image-tile {
    fill: var(--action);
  }
  .image-landscape {
    stroke: var(--on-action);
    stroke-width: 2;
  }
  .image-sun {
    fill: var(--art-lime);
  }
  .format-chip rect {
    fill: var(--surface);
    stroke: var(--border);
  }
  .format-chip text {
    fill: var(--text);
    text-anchor: middle;
    font:
      14px ui-monospace,
      monospace;
  }
  .control-feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
    padding: 3rem;
    background: var(--surface-muted);
    border: 1px solid var(--border);
    border-radius: 1rem;
  }
  .control-tracks {
    stroke: var(--border);
    stroke-width: 2;
  }
  .control-values {
    stroke: var(--accent);
    stroke-width: 2;
  }
  .control-art circle {
    fill: var(--surface);
    stroke: var(--accent);
    stroke-width: 2;
  }
  .control-feature .command-note {
    font-size: 0.75rem;
    border-left: 1px solid var(--accent);
    padding-left: 1rem;
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .feature-visual svg {
      transition: transform var(--duration-travel) var(--ease-out);
    }
    .feature-row:hover .feature-visual svg {
      transform: translateY(-5px) rotate(-1deg);
    }
  }
  @media (max-width: 52rem) {
    .feature-row,
    .feature-reverse,
    .control-feature {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .feature-reverse .feature-visual,
    .feature-reverse .feature-copy {
      grid-column: auto;
      grid-row: auto;
    }
    .feature-row {
      margin-block: 3rem 4rem;
    }
    .feature-visual {
      max-width: 34rem;
      width: 100%;
      justify-self: center;
    }
    .control-feature {
      padding: 1.5rem;
    }
    .control-art {
      max-width: 28rem;
      width: 100%;
      justify-self: center;
    }
  }
</style>
