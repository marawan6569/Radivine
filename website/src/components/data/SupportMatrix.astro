---
import { catalog } from "../../data/catalog";
import SupportLabel from "./SupportLabel.astro";
import EvidenceLinks from "./EvidenceLinks.astro";
---

<p id="matrix-help" class="muted">
  On smaller screens, scroll the table horizontally. Every qualification and
  evidence link remains available.
</p>
<div
  class="matrix-scroll"
  role="region"
  aria-label="Desktop compatibility matrix"
  aria-describedby="matrix-help"
  tabindex="0"
>
  <table>
    <caption>
      Wheel compatibility by environment — reviewed 27 October 2026
    </caption>
    <thead>
      <tr>
        <th scope="col">Environment & verification</th>
        <th scope="col">Activation</th>
        <th scope="col">Layout & integration</th>
        <th scope="col">Limits & evidence</th>
      </tr>
    </thead>
    <tbody>
      {catalog.compatibility.map((row) => (
        <tr>
          <th scope="row">
            <strong>
              {row.os} {row.osVersion}
            </strong>
            <span>
              {row.desktop}
              <br />
              {row.fileManager}
              <br />
              {row.architecture} · {row.session}
            </span>
            <SupportLabel status={row.status} label={row.publicLabel} />
            <small>Package: {row.packageStatus.replaceAll("-", " ")}</small>
          </th>
          <td>
            {["drag", "invoke"].map((key) => (
              <div class="capability">
                <strong>{key === "drag" ? "Drag + Shift" : "Invoke"}</strong>
                <SupportLabel
                  status={
                    row.capabilities[key as "drag" | "invoke"].availability
                  }
                />
                <p>
                  {row.capabilities[key as "drag" | "invoke"].qualification}
                </p>
              </div>
            ))}
          </td>
          <td>
            {["concentric", "properties"].map((key) => (
              <div class="capability">
                <strong>
                  {key === "concentric" ? "Concentric Rings" : "Properties"}
                </strong>
                <SupportLabel
                  status={
                    row.capabilities[key as "concentric" | "properties"]
                      .availability
                  }
                />
                <p>
                  {
                    row.capabilities[key as "concentric" | "properties"]
                      .qualification
                  }
                </p>
              </div>
            ))}
          </td>
          <td>
            <p>{row.note}</p>
            <p>
              <strong>Still to verify:</strong> {row.manualChecks.join(" ")}
            </p>
            <EvidenceLinks
              ids={row.verification.flatMap((v) => v.evidenceIds)}
            />
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
<style>
  #matrix-help {
    font-size: 0.8rem;
  }
  .matrix-scroll {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 0.6rem;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 61rem;
    table-layout: fixed;
    font-size: 0.8rem;
  }
  caption {
    text-align: left;
    padding: 1.25rem;
    background: var(--surface-muted);
    font-weight: 550;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  thead th {
    font:
      0.65rem/1.5 ui-monospace,
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--surface);
  }
  th:first-child {
    width: 25%;
  }
  th:last-child {
    width: 31%;
  }
  tbody th {
    font-weight: 400;
  }
  tbody th strong {
    display: block;
    font-size: 1rem;
    margin-bottom: 0.7rem;
  }
  tbody th > span {
    display: block;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  small {
    display: block;
    margin-top: 0.75rem;
    color: var(--text-muted);
  }
  p {
    color: var(--text-muted);
    margin: 0.6rem 0;
  }
  .capability + .capability {
    margin-top: 1.5rem;
  }
  .capability > strong {
    display: block;
    margin-bottom: 0.5rem;
  }
  tr:last-child th,
  tr:last-child td {
    border-bottom: 0;
  }
</style>
