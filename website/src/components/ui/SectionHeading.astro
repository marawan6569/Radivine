---
interface Props {
  eyebrow: string;
  title: string;
  id: string;
}
const { eyebrow, title, id } = Astro.props;
---

<div class="section-heading">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  <slot />
</div>
<style>
  .section-heading {
    max-width: 43rem;
    margin-bottom: 2.75rem;
  }
  h2 {
    margin-bottom: 1.25rem;
  }
</style>
