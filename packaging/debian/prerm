#!/bin/sh
set -e

if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
    if command -v radivine >/dev/null 2>&1; then
        for sock in /run/user/*/radivine/radivine.sock /run/user/*/radivine.sock; do
            if [ -S "$sock" ]; then
                radivine --socket "$sock" quit >/dev/null 2>&1 || true
            fi
        done
    fi
    if command -v pkill >/dev/null 2>&1; then
        pkill -TERM -x radivine-worker >/dev/null 2>&1 || true
    fi
fi

exit 0
