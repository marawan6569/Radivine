[Unit]
Description=Radivine Background Job Worker (On-Demand)
Documentation=https://github.com/marawan6569/Radivine
After=default.target dbus.socket
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/radivine-worker serve
Restart=on-failure
RestartSec=1
RestartForceExitStatus=75
SuccessExitStatus=0 143
TimeoutStopSec=6
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h %t /tmp /media /mnt /run/media
