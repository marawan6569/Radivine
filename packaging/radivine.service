[Unit]
Description=Radivine — Context-aware radial action wheel daemon
Documentation=https://github.com/marawan6569/Radivine
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/radivine daemon
ExecReload=/usr/bin/radivine reload
ExecStop=/usr/bin/radivine quit
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
